  "outcome": "No open material findings in the reviewed final shared content. Three findings raised during review are resolved, with direct pinned source citations and source-register receipts integrated.",
  "findings": [
    {
      "id": "SB01",
      "priority": "P2",
      "status": "resolved",
      "title": "Prevent SWE-bench evaluator cache reuse across A/B candidates",
      "location": {
        "path": "benchmarks/MODEL-BENCHMARKS.md",
        "line": 30
      },
      "related_location": {
        "path": "benchmarks/experiment.template.json",
        "line": 157
      },
      "trigger": "A candidate or independent attempt reuses run_id, model_name_or_path and instance_id while the patch changes.",
      "impact": "The official evaluator returns an existing report without executing the new patch; baseline scores can silently be attributed to the candidate.",
      "primary_evidence": [
        "MB-SWEBENCH-EVAL"
      ],
      "evidence_detail": "At the pinned evaluator, log_dir includes run_id/model_name_or_path/instance_id and an existing report is returned before applying the model patch. Mutable official evaluation docs independently describe the cache behavior.",
      "resolution": "Guide now requires a unique evaluator run/cache namespace for every candidate and independent attempt and verifies reports against the current patch/task manifest. Template now has evaluator_run_id_and_cache_namespace."
    },
    {
      "id": "SB02",
      "priority": "P2",
      "status": "resolved",
      "title": "Verify the effective LiveCodeBench full-mode selection",
      "location": {
        "path": "benchmarks/MODEL-BENCHMARKS.md",
        "line": 37
      },
      "trigger": "Select full tests with --not_fast while intending to freeze a release/date interval through CLI flags.",
      "impact": "At pinned 28fef95e, the full loader ignores its release_version argument and does not receive date filters, so the effective evaluation population can differ from the declared one.",
      "primary_evidence": [
        "MB-LIVECODEBENCH-LOADER",
        "MB-LIVECODEBENCH-ROUTER"
      ],
      "evidence_detail": "load_code_generation_dataset_not_fast(release_version) calls load_dataset(\"livecodebench/code_generation\", split=\"test\") without the release argument. scenario_router sends start_date/end_date only to the lite loader.",
      "resolution": "Guide now explicitly requires checking loaded IDs/date range and a separately validated pinned loader/filter and item manifest for full-mode experiments. Both pinned loader/router sources are directly cited and registered."
    },
    {
      "id": "SB03",
      "priority": "P3",
      "status": "resolved",
      "title": "Describe the probe as recording timing/counts, not delta content",
      "location": {
        "path": "benchmarks/PROTOCOL.md",
        "line": 37
      },
      "trigger": "Read \"records semantic deltas\" as a promise that generated text can be recovered from the result JSON.",
      "impact": "The code stores counts and first-content timings but no assembled answer/tool/reasoning content.",
      "primary_evidence": [
        "benchmarks/run_streaming.py:72",
        "benchmarks/run_streaming.py:124",
        "benchmarks/run_streaming.py:128"
      ],
      "resolution": "Protocol now says it records timings and counts of semantic deltas plus usage; adjacent quality-evaluator boundary remains explicit."
    }
  ],
