  "findings": [
    {
      "id": "SGX-01",
      "priority": "P3",
      "status": "resolved_and_rechecked",
      "path": "frameworks/sglang/EXPERIMENTS.md",
      "line": 80,
      "title": "Make the first GLM PD treatment concrete",
      "detail": "The cited recipe has two distinct connector presentations. Its manual mechanically checked arm is TP2+TP2 NIXL with BF16 KV, TileLang DSA and Triton MoE; the Playground only offers Mooncake. The proposed TP4+TP4 cell should explicitly state it is a scaling adaptation, select the initial manual backend set, exclude prefill CP and retain the same-node port/UCX controls. This prevents accidental backend confounding or interpreting 4+4 as the published validated topology.",
      "source_id": "GEXP-GLMFLASH",
      "resolved_at_utc": "2026-10-15T22:45:04.086844+00:00",
      "resolution": "SOURCE_REVIEW and G09 now identify TP2+TP2 dummy-only upstream, the 4+4 atlas adaptation, NIXL/BF16 KV/TileLang DSA/Triton MoE, disabled speculation/prefill CP, matched TP and colocated backend controls, distinct NCCL ports, bootstrap matching and documented UCX environment; alternate Mooncake and untested FlashInfer TRT-LLM PD are separate."
    },
    {
      "id": "SGX-02",
      "priority": "P3",
      "status": "resolved_and_rechecked",
      "path": "frameworks/sglang/SOURCE_REVIEW.md",
      "line": 47,
      "title": "Name simulated acceptance in the cited Qwen speed evidence",
      "detail": "The source already limits the B200 combined-series results correctly. Explicitly adding that speed runs used simulated acceptance length 3.3, while the accuracy run used natural acceptance, would make the evidence boundary easier to reuse without misinterpretation. No numeric gain is currently asserted in the atlas.",
      "source_id": "GEXP-PR41175",
      "resolved_at_utc": "2026-10-15T22:45:04.086844+00:00",
      "resolution": "SOURCE_REVIEW explicitly distinguishes simulated acceptance 3.3 for combined-series B200 speed from natural acceptance for accuracy, with no isolated patch or B300 qualification claim."
    }
  ],
