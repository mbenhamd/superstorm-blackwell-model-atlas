# Optional. Without DATABASE_URL the API uses process-local memory.
# For persistence: bun run db:up; copy this file to .env; migrate; seed.
DATABASE_URL=postgres://bench_console:local_poc_only@127.0.0.1:5432/bench_console
HOST=127.0.0.1
PORT=3000
# POC_ALLOW_REMOTE is intentionally unset. There is no production authentication.
# Memory mode only: load a validated runs file (scripts/import-runs.ts format). Never set in production.
# RUNS_FILE=tests/fixtures/sample-runs.json
